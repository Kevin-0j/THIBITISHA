# Copy to .env and edit. Never commit .env.

PORT=3000

# Product brand. The only place the product name lives; change it here when the new name is picked.
BRAND_NAME=Thibitisha

# --- Database ---------------------------------------------------------------
# Leave empty to run on the in-memory demo store (enough for the sandbox simulator).
# For Supabase: Project Settings > Database > Connection string > "Transaction pooler" (port 6543).
DATABASE_URL=
# Optional: path to Supabase's CA certificate (Project Settings > Database > SSL) to verify the server.
DATABASE_CA_CERT=

# --- Africa's Talking SMS (owner alerts) -------------------------------------
# "sandbox" + your sandbox API key: messages show up in the simulator, free.
# Leave AT_API_KEY empty to just print SMS to the console.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# --- Demo data (in-memory store only) ------------------------------------------
# Type these numbers into the sandbox simulator to act as each person.
DEMO_VENUE_NAME=Backyard Bar & Motel
DEMO_VENUE_PLAN=plus
DEMO_MANAGER_PHONE=+254711000001
DEMO_HOUSEKEEPER_PHONE=+254711000002
DEMO_OWNER_PHONE=+254711000003
